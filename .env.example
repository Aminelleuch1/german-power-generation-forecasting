# Copy this file to `.env` and fill in your own credentials.
# `.env` is git-ignored — never commit real keys.
#
#   cp .env.example .env
#   set -a && source .env && set +a     # export everything into the shell
#   python main.py

# ── ENTSO-E Transparency Platform (required) ───────────────────────────
# Free. Register at https://transparency.entsoe.eu/ , then email
# transparency@entsoe.eu asking for API access; they return a security token.
# Used for: actual generation, load, installed capacity, hydro forecasts.
ENTSOE_API_KEY=

# ── Supabase (optional) ────────────────────────────────────────────────
# Only needed if you pull commodity prices (TTF gas, coal, EUA carbon) from
# a Supabase table via Import_Data_Supabase.py. Skip these if you supply
# data/Gas_TTF_rows.csv, data/Coal_rows.csv and data/EUA_rows.csv yourself.
SUPABASE_URL=
SUPABASE_KEY=

# ── Open-Meteo ─────────────────────────────────────────────────────────
# No key required for the endpoints used here (archive, forecast,
# historical-forecast, previous-runs). Listed for completeness only.
